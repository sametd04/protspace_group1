# OS
.DS_Store

# IDE / tools
/.vscode
/.uv-bin
/.claude
/.playwright-mcp
/.ruff_cache

# Project-specific
/docs/publication

# --- data ---
# Ignore all data directories except curated dataset folders
/data/*
!/data/3FTx
!/data/Pla2g2
!/data/toxins
!/data/3ftx/
!/data/toxprot/
!/data/pla2g2/
!/data/cath_s40/
!/data/swissprot_rr/
# Always ignore pdb subdirectories, tmp subdirectories, .h5 files, and generated projections
**/pdb/
**/tmp/
**/*.h5
!/data/3ftx/*.h5
!/data/toxprot/*.h5
!/data/pla2g2/*.h5
!/data/cath_s40/*.h5
!/data/swissprot_rr/*.h5
**/*.npy

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Testing / coverage
htmlcov/
.coverage
.coverage.*
coverage.xml
.pytest_cache/

# Environments
.env
.venv
venv/

# Jupyter
.ipynb_checkpoints

# Logs
*.log
