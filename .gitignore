# OS
.DS_Store

# IDE / tools
/.vscode
/.uv-bin
/.claude
/.playwright-mcp
/.ruff_cache

# Project-specific
/docs/publication
/output/

# --- data ---
# Ignore all data directories except whitelisted ones
/data/*
!/data/3FTx
!/data/3ftx
!/data/Pla2g2
!/data/pla2g2
!/data/toxins
!/data/toxprot
!/data/jmb_2025
!/data/cath_s40
!/data/swissprot_rr
# Always ignore pdb subdirectories, tmp subdirectories, and .h5 files everywhere
**/pdb/
**/tmp/
**/*.h5
**/*.npy

# Never commit benchmark outputs
**/metrics.csv
**/*.pargquet
**/*.parquetbundle

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Testing / coverage
htmlcov/
.coverage
.coverage.*
coverage.xml
.pytest_cache/

# Environments
.env
.venv
venv/

# Jupyter
.ipynb_checkpoints

# Logs
*.log
